# Клиент секретов не хранит. Переменные нужны только серверу (server/.env):
#   TELEGRAM_BOT_TOKEN=...   (из @BotFather; перевыпустить перед деплоем)
#   PORT=8080
# Клиент при необходимости знает адрес бэкенда (пусто = тот же origin, что отдал страницу):
VITE_SERVER_URL=
# Юзернейм бота без @ — нужен для ссылок-приглашений t.me/<bot>/app?startapp=CODE
VITE_BOT_USERNAME=
